{
  "id": "app2clap",
  "requires_standard_install": true,
  "display_name": "app2clap",
  "display_name_key": "package-app2clap",
  "display_description_key": "package-app2clap-description",
  "package_kind": "user_plugin_binary",
  "install_destination": "windows_clap_dir",
  "required": false,
  "recommended": false,
  "supported_platforms": [
    "windows"
  ],
  "supported_architectures": [
    "x64"
  ],
  "github_release": {
    "repo": "jcsteh/app2clap",
    "release": {
      "tag": "snapshots"
    },
    "version_from": {
      "asset_name": {
        "prefix": "app2clap_",
        "suffix": ".zip",
        "strip_trailing_dot_segment": true
      }
    },
    "assets": [
      {
        "platform": "windows",
        "arch": "x64",
        "name_prefix": "app2clap_",
        "name_suffix": ".zip"
      }
    ],
    "artifact_kind": "archive"
  },
  "detectors": [
    "rabbit_receipt",
    "user_plugin_file"
  ],
  "install_steps": [
    "copy_user_plugin_binary"
  ],
  "uninstall": {
    "plans": [
      {
        "platform": "windows",
        "strategy": "remove_files",
        "summary": {
          "removes_key": "uninstall-summary-app2clap-removes",
          "keeps_key": "uninstall-summary-app2clap-keeps"
        },
        "remove": {
          "receipt_files": true,
          "paths": [
            "{clap_dir}/app2clap.clap"
          ]
        },
        "kept_user_data": [
          {
            "path": "{clap_dir}",
            "note_key": "uninstall-kept-app2clap-clap-folder"
          }
        ]
      }
    ]
  },
  "backup_policy": "backup_overwritten_files",
  "user_plugin_prefixes": [
    "app2clap"
  ],
  "user_plugin_suffixes": {
    "windows": [
      ".clap"
    ],
    "macos": []
  },
  "category": "additional"
}
