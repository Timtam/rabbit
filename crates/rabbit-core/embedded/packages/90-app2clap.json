{
  "id": "app2clap",
  "display_name": "app2clap",
  "display_name_key": "package-app2clap",
  "display_description_key": "package-app2clap-description",
  "package_kind": "user_plugin_binary",
  "install_destination": "user_plugins_fx",
  "former_install_destinations": [
    "windows_clap_dir"
  ],
  "required": false,
  "recommended": false,
  "supported_platforms": [
    "windows"
  ],
  "supported_architectures": [
    "x64",
    "arm64",
    "arm64-ec"
  ],
  "github_release": {
    "repo": "jcsteh/app2clap",
    "release": {
      "tag": "snapshots"
    },
    "version_from": {
      "asset_name": {
        "prefix": "app2clap_",
        "suffix": ".zip",
        "strip_trailing_dot_segment": true
      }
    },
    "assets": [
      {
        "platform": "windows",
        "arch": "x64",
        "name_prefix": "app2clap_",
        "name_suffix": ".zip"
      },
      {
        "platform": "windows",
        "arch": "arm64",
        "report_arch": "x64",
        "name_prefix": "app2clap_",
        "name_suffix": ".zip"
      },
      {
        "platform": "windows",
        "arch": "arm64-ec",
        "report_arch": "x64",
        "name_prefix": "app2clap_",
        "name_suffix": ".zip"
      }
    ],
    "artifact_kind": "archive"
  },
  "detectors": [
    "rabbit_receipt",
    "user_plugin_file"
  ],
  "install_steps": [
    "copy_user_plugin_binary"
  ],
  "uninstall": {
    "plans": [
      {
        "platform": "windows",
        "target": "standard",
        "strategy": "remove_files",
        "summary": {
          "removes_key": "uninstall-summary-app2clap-removes-standard",
          "keeps_key": "uninstall-summary-app2clap-keeps"
        },
        "remove": {
          "receipt_files": true,
          "paths": [
            "{resource}/UserPlugins/FX/app2clap.clap",
            "{clap_dir}/app2clap.clap"
          ]
        }
      },
      {
        "platform": "windows",
        "target": "portable",
        "strategy": "remove_files",
        "summary": {
          "removes_key": "uninstall-summary-app2clap-removes",
          "keeps_key": "uninstall-summary-app2clap-keeps"
        },
        "remove": {
          "receipt_files": true,
          "paths": [
            "{resource}/UserPlugins/FX/app2clap.clap"
          ]
        }
      }
    ]
  },
  "backup_policy": "backup_overwritten_files",
  "user_plugin_prefixes": [
    "app2clap"
  ],
  "user_plugin_suffixes": {
    "windows": [
      ".clap"
    ],
    "macos": []
  },
  "category": "tools"
}
