{
  "id": "reaper",
  "display_name": "REAPER",
  "display_name_key": "package-reaper",
  "display_description_key": "package-reaper-description",
  "package_kind": "reaper_app",
  "required": false,
  "recommended": true,
  "supported_platforms": [
    "windows",
    "macos"
  ],
  "supported_architectures": [
    "x86",
    "x64",
    "arm64",
    "arm64-ec",
    "universal"
  ],
  "version": {
    "html": {
      "url": "https://www.reaper.fm/download.php",
      "pattern": "Version ([0-9][0-9.]*)"
    }
  },
  "whats_new": {
    "text_changelog": {
      "url": "https://www.reaper.fm/whatsnew.txt",
      "section_start": "^v[0-9]"
    }
  },
  "detectors": [
    "reaper_app",
    "file_version_metadata"
  ],
  "install_steps": [
    "run_upstream_installer"
  ],
  "uninstall": {
    "plans": [
      {
        "platform": "windows",
        "target": "standard",
        "strategy": "vendor_uninstaller",
        "elevation": "required",
        "backup": "none",
        "summary": {
          "removes_key": "uninstall-summary-reaper-windows-removes",
          "keeps_key": "uninstall-summary-reaper-keeps"
        },
        "vendor_uninstaller": {
          "kind": "nsis",
          "locate": [
            {
              "registry": {
                "hive": "hklm",
                "key": "REAPER",
                "value": "UninstallString"
              }
            }
          ],
          "install_location": {
            "registry": {
              "hive": "hklm",
              "key": "REAPER",
              "value": "InstallLocation"
            },
            "must_equal": "{app_dir}"
          },
          "must_be_in": {
            "under": "{program_files}"
          },
          "arguments": [
            "/S"
          ],
          "timeout_seconds": 600,
          "success_exit_codes": [
            1223
          ],
          "verify_gone": [
            "{app_path}"
          ]
        },
        "kept_user_data": [
          {
            "path": "{resource}",
            "note_key": "uninstall-kept-reaper-resource"
          }
        ]
      },
      {
        "platform": "windows",
        "target": "portable",
        "strategy": "manual",
        "note_key": "uninstall-manual-reaper-portable"
      },
      {
        "platform": "macos",
        "strategy": "remove_files",
        "elevation": "if_needed",
        "backup": "to_trash",
        "summary": {
          "removes_key": "uninstall-summary-reaper-macos-removes",
          "keeps_key": "uninstall-summary-reaper-keeps"
        },
        "remove": {
          "trees": [
            {
              "path": "{app_path}",
              "must_end_with": ".app",
              "name_contains": "REAPER",
              "bundle_id": "com.cockos.reaper"
            }
          ]
        },
        "kept_user_data": [
          {
            "path": "{resource}",
            "note_key": "uninstall-kept-reaper-resource"
          }
        ]
      }
    ]
  },
  "backup_policy": "none",
  "user_plugin_prefixes": [],
  "user_plugin_suffixes": {
    "windows": [],
    "macos": []
  },
  "http_artifact": {
    "targets": [
      {
        "platform": "windows",
        "match_arches": [
          "x86"
        ],
        "report_arch": "x86",
        "artifact_kind": "installer",
        "source": {
          "scrape_href": {
            "page_url": "https://www.reaper.fm/download.php",
            "base_url": "https://www.reaper.fm/",
            "match": {
              "contains": [
                "-install.exe"
              ],
              "not_contains": [
                "_x64",
                "arm64ec"
              ],
              "ends_with": "-install.exe"
            }
          }
        }
      },
      {
        "platform": "windows",
        "match_arches": [
          "x64",
          "universal",
          "unknown"
        ],
        "report_arch": "x64",
        "artifact_kind": "installer",
        "source": {
          "scrape_href": {
            "page_url": "https://www.reaper.fm/download.php",
            "base_url": "https://www.reaper.fm/",
            "match": {
              "contains": [
                "_x64-install.exe"
              ],
              "ends_with": "-install.exe"
            }
          }
        }
      },
      {
        "platform": "windows",
        "match_arches": [
          "arm64",
          "arm64-ec"
        ],
        "report_arch": "arm64-ec",
        "artifact_kind": "installer",
        "source": {
          "scrape_href": {
            "page_url": "https://www.reaper.fm/download.php",
            "base_url": "https://www.reaper.fm/",
            "match": {
              "contains": [
                "arm64ec"
              ],
              "ends_with": "-install.exe"
            }
          }
        }
      },
      {
        "platform": "macos",
        "match_arches": [
          "x86"
        ],
        "report_arch": "x86",
        "artifact_kind": "disk_image",
        "source": {
          "scrape_href": {
            "page_url": "https://www.reaper.fm/download.php",
            "base_url": "https://www.reaper.fm/",
            "match": {
              "contains": [
                "_i386.dmg"
              ],
              "ends_with": "_i386.dmg"
            }
          }
        }
      },
      {
        "platform": "macos",
        "match_arches": [
          "x64",
          "arm64",
          "arm64-ec",
          "universal",
          "unknown"
        ],
        "report_arch": "universal",
        "artifact_kind": "disk_image",
        "source": {
          "scrape_href": {
            "page_url": "https://www.reaper.fm/download.php",
            "base_url": "https://www.reaper.fm/",
            "match": {
              "contains": [
                "_universal.dmg"
              ],
              "ends_with": "_universal.dmg"
            }
          }
        }
      }
    ]
  },
  "channels": [
    {
      "id": "dev",
      "display_name_key": "package-channel-reaper-dev",
      "expert": true,
      "version": {
        "html": {
          "url": "https://www.landoleet.org/?C=M;O=D",
