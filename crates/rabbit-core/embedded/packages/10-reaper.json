              "unknown"
            ],
            "report_arch": "universal",
            "artifact_kind": "disk_image",
            "source": {
              "scrape_href": {
                "page_url": "https://www.landoleet.org/?C=M;O=D",
                "base_url": "https://www.landoleet.org/",
                "match": {
                  "contains": [
                    "_universal.dmg"
