{
  "id": "jaws-scripts",
  "requires_standard_install": true,
  "display_name": "JAWS-for-REAPER scripts",
  "display_name_key": "package-jaws-scripts",
  "display_description_key": "package-jaws-scripts-description",
  "package_kind": "screen_reader_scripts",
  "depends_on": [
    "reaper"
  ],
  "required": false,
  "recommended": false,
  "recommended_when": "jaws_installed",
  "supported_platforms": [
    "windows"
  ],
  "supported_architectures": [
    "x86",
    "x64",
    "arm64",
    "arm64-ec"
  ],
  "hfs_listing": {
    "base": "https://hoard.reaperaccessibility.com",
    "folder": "/Custom%20actions,%20Scripts%20and%20jsfx/Windows%20Scripts/JAWS%20Scripts%20by%20Snowman/",
    "artifact_kind": "installer"
  },
  "detectors": [
    "rabbit_receipt",
    "jaws_uninstall_exe"
  ],
  "install_steps": [
    "run_upstream_installer"
  ],
  "uninstall": {
    "machine_wide_warning": false,
    "install_snapshot": [
      "{appdata}/Freedom Scientific/JAWS/*/Settings/*",
      "{appdata}/REAPER/UserPlugins"
    ],
    "plans": [
      {
        "platform": "windows",
        "strategy": "remove_files",
        "summary": {
          "removes_key": "uninstall-summary-jaws-scripts-removes",
          "keeps_key": "uninstall-summary-jaws-scripts-keeps"
        },
        "remove": {
          "paths": [
            "{appdata}/REAPER/UserPlugins/Reaper_ComAccess32.dll",
            "{appdata}/REAPER/UserPlugins/Reaper_ComAccess64.dll"
          ],
          "vendor_added_files": {
            "files": [
              "{appdata}/Freedom Scientific/JAWS/*/Settings/*/*"
            ],
            "by_hand_note_key": "uninstall-note-jaws-scripts-by-hand"
          }
        },
        "machine_cleanup": {
          "dir": "{program_files_x86}/Reaper_JawsScripts",
          "files": [
            "Uninstall.dat",
            "Uninstall.exe"
          ],
          "registry": {
            "hive": "hklm",
            "key": "Reaper_JawsScripts",
            "view": "bit32",
            "values": {
              "UninstallDirectory": "{program_files_x86}/Reaper_JawsScripts",
              "Uninstall.dat": "{program_files_x86}/Reaper_JawsScripts/Uninstall.dat"
            }
          },
          "by_hand_key": "uninstall-by-hand-jaws-scripts"
        }
      }
    ]
  },
  "backup_policy": "backup_overwritten_files",
  "user_plugin_prefixes": [],
  "user_plugin_suffixes": {
    "windows": [],
    "macos": []
  }
}
