{
  "id": "osara",
  "display_name": "OSARA",
  "display_name_key": "package-osara",
  "display_description_key": "package-osara-description",
  "package_kind": "user_plugin_binary",
  "depends_on": [
    "reaper"
  ],
  "required": false,
  "recommended": true,
  "supported_platforms": [
    "windows",
    "macos"
  ],
  "supported_architectures": [
    "x86",
    "x64",
    "arm64",
    "arm64-ec",
    "universal"
  ],
  "version": {
    "json": {
      "url": "https://osara.reaperaccessibility.com/snapshots/update.json",
      "pointer": "/version"
    }
  },
  "whats_new": {
    "json_commits": {
      "url": "https://osara.reaperaccessibility.com/snapshots/update.json",
      "pointer": "/commits"
    }
  },
  "detectors": [
    "rabbit_receipt",
    "user_plugin_file",
    {
      "uninstall_display_version": {
        "display_name": "OSARA"
      }
    },
    "file_version_metadata",
    "reapack_registry",
    {
      "binary_version_string": {
        "pattern": "(pr[0-9]+-[0-9]+,[0-9a-fA-F]+)",
        "label": "osara-pull-request-binary-version-string",
        "note": "Version came from a best-effort scan for the embedded version string of a pull-request test build."
      }
    },
    {
      "binary_version_string": {
        "pattern": "(20[0-9]{2}(?:\\.[0-9]+){2,})",
        "label": "osara-binary-version-string",
        "note": "Version came from a best-effort scan for OSARA's embedded version string."
      }
    }
  ],
  "install_steps": [
    "run_upstream_installer",
    "copy_user_plugin_binary"
  ],
  "uninstall_steps": [
    "remove_user_plugin_binary"
  ],
  "backup_policy": "backup_overwritten_files",
  "user_plugin_prefixes": [
    "reaper_osara"
  ],
  "user_plugin_suffixes": {
    "windows": [
      ".dll"
    ],
    "macos": [
      ".dylib"
    ]
  },
  "http_artifact": {
    "targets": [
      {
        "platform": "windows",
        "match_arches": [
          "x86",
          "x64",
          "arm64",
          "arm64-ec",
          "universal",
          "unknown"
        ],
        "report_arch": "universal",
        "artifact_kind": "installer",
        "source": {
          "scrape_href": {
            "page_url": "https://osara.reaperaccessibility.com/snapshots/",
            "base_url": "https://osara.reaperaccessibility.com/snapshots/",
            "match": {
              "contains": [
                "/jcsteh/osara/releases/download/snapshots/osara_"
              ],
              "ends_with": ".exe"
            }
          }
        }
      },
      {
        "platform": "macos",
        "match_arches": [
          "x86",
          "x64",
          "arm64",
          "arm64-ec",
          "universal",
          "unknown"
        ],
        "report_arch": "universal",
        "artifact_kind": "archive",
        "source": {
          "scrape_href": {
            "page_url": "https://osara.reaperaccessibility.com/snapshots/",
            "base_url": "https://osara.reaperaccessibility.com/snapshots/",
            "match": {
              "contains": [
                "/jcsteh/osara/releases/download/snapshots/osara_"
              ],
              "ends_with": ".zip"
            }
          }
        }
      }
    ]
  },
  "channels": [
    {
      "id": "pr",
      "display_name_key": "package-channel-osara-pr",
      "expert": true,
      "parameter": "pull_request",
      "version_comparison": "exact",
      "github_actions_artifact": {
        "repo": "jcsteh/osara",
        "download_url": "https://nightly.link/{repo}/actions/artifacts/{id}.zip",
        "targets": [
          {
            "platform": "windows",
            "name_prefix": "osara_windows_",
            "report_arch": "universal",
            "artifact_kind": "installer"
          },
          {
            "platform": "macos",
            "name_prefix": "osara_mac_",
            "report_arch": "universal",
            "artifact_kind": "archive"
          }
        ]
      }
    }
  ]
}
