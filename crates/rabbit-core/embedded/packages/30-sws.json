{
  "id": "sws",
  "display_name": "SWS Extension",
  "display_name_key": "package-sws",
  "display_description_key": "package-sws-description",
  "package_kind": "user_plugin_binary",
  "depends_on": [
    "reaper"
  ],
  "required": false,
  "recommended": true,
  "supported_platforms": [
    "windows",
    "macos"
  ],
  "supported_architectures": [
    "x86",
    "x64",
    "arm64",
    "universal"
  ],
  "version": {
    "html": {
      "url": "https://sws-extension.org/",
      "pattern": "Latest stable version:[\\s\\S]*?v([0-9.]+)[\\s\\S]*?#([0-9]+)",
      "format": "{1}.{2}"
    }
  },
  "whats_new": {
    "text_changelog": {
      "url": "https://raw.githubusercontent.com/reaper-oss/sws/master/whatsnew.txt",
      "section_start": "^!v"
    }
  },
  "detectors": [
    "rabbit_receipt",
    "user_plugin_file",
    "reapack_registry",
    "file_version_metadata",
    {
      "binary_version_string": {
        "pattern": "([0-9]+(?:\\.[0-9]+){2,}) #[0-9a-fA-F]{6,}",
        "label": "sws-binary-version-string",
        "note": "Version came from a best-effort scan for SWS's embedded `version #commit` string."
      }
    }
  ],
  "install_steps": [
    "run_upstream_installer",
    "copy_user_plugin_binary"
  ],
  "uninstall": {
    "reapack_owned": "block",
    "warn_when_installed": [
      {
        "package": "osara",
        "message_key": "uninstall-warning-sws-osara-keymap"
      },
      {
        "package": "reapack",
        "message_key": "uninstall-warning-sws-reapack-scripts"
      }
    ],
    "plans": [
      {
        "platform": "windows",
        "strategy": "remove_files",
        "summary": {
          "removes_key": "uninstall-summary-sws-removes",
          "keeps_key": "uninstall-summary-sws-keeps"
        },
        "remove": {
          "receipt_files": true,
          "matching_user_plugins": true,
          "paths": [
            "{resource}/Scripts/sws_python.py",
            "{resource}/Scripts/sws_python32.py",
            "{resource}/Scripts/sws_python64.py"
          ]
        },
        "kept_user_data": [
          {
            "path": "{resource}/Data/Grooves",
            "note_key": "uninstall-kept-sws-grooves"
          },
          {
            "path": "{resource}/S&M.ini",
            "note_key": "uninstall-kept-sws-settings"
          },
          {
            "path": "{resource}/S&M_Cyclactions.ini",
            "note_key": "uninstall-kept-sws-cycle-actions"
          },
          {
            "path": "{resource}/sws-autocoloricon.ini",
            "note_key": "uninstall-kept-sws-settings"
          },
          {
            "path": "{resource}/SWS-RenamePresets.txt",
            "note_key": "uninstall-kept-sws-settings"
          },
          {
            "path": "{resource}/BR.ini",
            "note_key": "uninstall-kept-sws-settings"
          }
        ]
      },
      {
        "platform": "macos",
        "strategy": "remove_files",
        "summary": {
          "removes_key": "uninstall-summary-sws-removes",
          "keeps_key": "uninstall-summary-sws-keeps"
        },
        "remove": {
          "receipt_files": true,
          "matching_user_plugins": true
        },
        "kept_user_data": [
          {
            "path": "{resource}/Data/Grooves",
            "note_key": "uninstall-kept-sws-grooves"
          },
          {
            "path": "{resource}/S&M.ini",
            "note_key": "uninstall-kept-sws-settings"
          },
          {
            "path": "{resource}/S&M_Cyclactions.ini",
            "note_key": "uninstall-kept-sws-cycle-actions"
          },
          {
            "path": "{resource}/sws-autocoloricon.ini",
            "note_key": "uninstall-kept-sws-settings"
          },
          {
            "path": "{resource}/SWS-RenamePresets.txt",
            "note_key": "uninstall-kept-sws-settings"
          },
          {
            "path": "{resource}/BR.ini",
            "note_key": "uninstall-kept-sws-settings"
          }
        ]
      }
    ]
  },
  "backup_policy": "backup_overwritten_files",
  "user_plugin_prefixes": [
    "reaper_sws"
  ],
  "user_plugin_suffixes": {
    "windows": [
      ".dll"
    ],
    "macos": [
      ".dylib"
    ]
  },
  "http_artifact": {
    "targets": [
      {
        "platform": "windows",
        "match_arches": [
          "x86"
        ],
        "report_arch": "x86",
        "artifact_kind": "installer",
        "source": {
          "scrape_href": {
            "page_url": "https://sws-extension.org/",
            "base_url": "https://sws-extension.org/",
            "match": {
              "contains": [
                "Windows-x86.exe"
              ]
            }
          }
        }
      },
      {
        "platform": "windows",
        "match_arches": [
          "x64",
          "unknown"
        ],
        "report_arch": "x64",
        "artifact_kind": "installer",
        "source": {
          "scrape_href": {
            "page_url": "https://sws-extension.org/",
            "base_url": "https://sws-extension.org/",
            "match": {
              "contains": [
                "Windows-x64.exe"
              ]
            }
          }
        }
      },
      {
        "platform": "macos",
        "match_arches": [
          "x86"
        ],
        "report_arch": "x86",
        "artifact_kind": "disk_image",
        "source": {
          "scrape_href": {
            "page_url": "https://sws-extension.org/",
            "base_url": "https://sws-extension.org/",
            "match": {
              "contains": [
                "Darwin-i386.dmg"
              ]
            }
          }
        }
      },
      {
        "platform": "macos",
        "match_arches": [
          "x64",
          "unknown"
        ],
        "report_arch": "x64",
        "artifact_kind": "disk_image",
        "source": {
          "scrape_href": {
            "page_url": "https://sws-extension.org/",
            "base_url": "https://sws-extension.org/",
            "match": {
              "contains": [
                "Darwin-x86_64.dmg"
              ]
            }
          }
        }
      },
      {
        "platform": "macos",
        "match_arches": [
          "arm64"
        ],
        "report_arch": "arm64",
        "artifact_kind": "disk_image",
        "source": {
          "scrape_href": {
            "page_url": "https://sws-extension.org/",
            "base_url": "https://sws-extension.org/",
            "match": {
              "contains": [
                "Darwin-arm64.dmg"
              ]
            }
          }
        }
      }
    ]
  }
}
