{
  "id": "surge-xt",
  "requires_standard_install": true,
  "display_name": "Surge XT",
  "display_name_key": "package-surge-xt",
  "display_description_key": "package-surge-xt-description",
  "package_kind": "user_plugin_binary",
  "required": false,
  "recommended": false,
  "supported_platforms": [
    "windows",
    "macos"
  ],
  "supported_architectures": [
    "x64",
    "arm64",
    "arm64-ec",
    "universal"
  ],
  "detectors": [
    "rabbit_receipt",
    "surge_vendor_files"
  ],
  "install_steps": [
    "run_upstream_installer"
  ],
  "uninstall": {
    "plans": [
      {
        "platform": "windows",
        "strategy": "vendor_uninstaller",
        "elevation": "required",
        "backup": "none",
        "summary": {
          "removes_key": "uninstall-summary-surge-removes",
          "keeps_key": "uninstall-summary-surge-keeps"
        },
        "blocking_programs": [
          "Surge XT.exe",
          "Surge XT Effects.exe"
        ],
        "vendor_uninstaller": {
          "kind": "inno",
          "locate": [
            {
              "registry": {
                "hive": "hklm",
                "key": "69F3FE96-DEEC-4C7C-B72D-E8957EC8411B_is1",
                "value": "UninstallString"
              }
            }
          ],
          "must_be_in": {
            "dir": "{program_data}/Surge XT/uninstall",
            "only_files": "unins000.*"
          },
          "arguments": [
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART"
          ],
          "timeout_seconds": 600,
          "verify_gone": [
            "{common_program_files}/VST3/Surge Synth Team/Surge XT.vst3",
            "{common_program_files}/VST3/Surge Synth Team/Surge XT Effects.vst3",
            "{common_program_files}/CLAP/Surge Synth Team/Surge XT.clap",
            "{common_program_files}/CLAP/Surge Synth Team/Surge XT Effects.clap"
          ],
          "remove_leftovers": [
            {
              "junction": "{common_program_files}/CLAP/Surge Synth Team/SurgeXTData"
            },
            {
              "junction": "{common_program_files}/VST3/Surge Synth Team/SurgeXTData"
            },
            {
              "empty_dir": "{common_program_files}/CLAP/Surge Synth Team/SurgeXTData"
            },
            {
              "empty_dir": "{common_program_files}/VST3/Surge Synth Team/SurgeXTData"
            },
            {
              "empty_dir": "{common_program_files}/CLAP/Surge Synth Team"
            },
            {
              "empty_dir": "{common_program_files}/VST3/Surge Synth Team"
            }
          ]
        },
        "kept_user_data": [
          {
            "path": "{documents}/Surge XT",
            "note_key": "uninstall-kept-surge-user-data"
          }
        ],
        "note_key": "uninstall-note-surge-fonts-stay"
      },
      {
        "platform": "macos",
        "strategy": "remove_files",
        "elevation": "required",
        "backup": "none",
        "summary": {
          "removes_key": "uninstall-summary-surge-macos-removes",
          "keeps_key": "uninstall-summary-surge-keeps"
        },
        "blocking_programs": [
          "Surge XT",
          "Surge XT Effects",
          "surge-xt-cli"
        ],
        "remove": {
          "trees": [
            {
              "path": "/Applications/Surge XT.app",
              "must_end_with": ".app",
              "name_contains": "Surge XT"
            },
            {
              "path": "/Applications/Surge XT Effects.app",
              "must_end_with": ".app",
              "name_contains": "Surge XT"
            },
            {
              "path": "/Library/Audio/Plug-Ins/Components/Surge XT.component",
              "must_end_with": ".component",
              "name_contains": "Surge XT"
            },
            {
              "path": "/Library/Audio/Plug-Ins/Components/Surge XT Effects.component",
              "must_end_with": ".component",
              "name_contains": "Surge XT"
            },
            {
              "path": "/Library/Audio/Plug-Ins/CLAP/Surge XT.clap",
              "must_end_with": ".clap",
              "name_contains": "Surge XT"
            },
            {
              "path": "/Library/Audio/Plug-Ins/CLAP/Surge XT Effects.clap",
              "must_end_with": ".clap",
              "name_contains": "Surge XT"
            },
            {
              "path": "/Library/Audio/Plug-Ins/LV2/Surge XT.lv2",
              "must_end_with": ".lv2",
              "name_contains": "Surge XT"
            },
            {
              "path": "/Library/Audio/Plug-Ins/LV2/Surge XT Effects.lv2",
              "must_end_with": ".lv2",
              "name_contains": "Surge XT"
            },
            {
              "path": "/Library/Application Support/Surge XT",
              "name_contains": "Surge XT"
            },
            {
              "path": "/Library/Audio/Plug-Ins/VST3/Surge XT Effects.vst3",
              "must_end_with": ".vst3",
              "name_contains": "Surge XT"
            },
            {
              "path": "/Library/Audio/Plug-Ins/VST3/Surge XT.vst3",
              "must_end_with": ".vst3",
              "name_contains": "Surge XT"
            }
          ]
        },
        "macos_pkg_forget": [
          "org.surge-synth-team.surge-xt.vst3.pkg",
          "org.surge-synth-team.surge-xt.component.pkg",
          "org.surge-synth-team.surge-xt.clap.pkg",
          "org.surge-synth-team.surge-xt.lv2.pkg",
          "org.surge-synth-team.surge-xt.app.pkg",
          "org.surge-synth-team.surge-xt.resources.pkg",
          "org.surge-synth-team.surge-xt-fx.vst3.pkg",
          "org.surge-synth-team.surge-xt-fx.component.pkg",
          "org.surge-synth-team.surge-xt-fx.clap.pkg",
          "org.surge-synth-team.surge-xt-fx.lv2.pkg",
          "org.surge-synth-team.surge-xt-fx.app.pkg",
          "com.surge-synth-team.surge-xt.vst3.pkg",
          "com.surge-synth-team.surge-xt.component.pkg",
          "com.surge-synth-team.surge-xt.app.pkg",
          "com.surge-synth-team.surge-xt.resources.pkg",
          "com.surge-synth-team.surge-xt-fx.vst3.pkg",
          "com.surge-synth-team.surge-xt-fx.component.pkg",
          "com.surge-synth-team.surge-xt-fx.app.pkg"
        ],
        "kept_user_data": [
          {
            "path": "{documents}/Surge XT",
            "note_key": "uninstall-kept-surge-user-data"
          },
          {
            "path": "{documents}/Surge Synth Team/Surge XT",
            "note_key": "uninstall-kept-surge-user-data"
          },
          {
            "path": "{home}/Library/Application Support/Surge Synth Team/Surge XT",
            "note_key": "uninstall-kept-surge-settings-macos"
          },
          {
            "path": "{home}/Library/Application Support/Surge XT",
            "note_key": "uninstall-kept-surge-factory-copy-macos"
          }
        ],
        "post": [
          {
            "refresh_audio_units": {}
          }
        ]
      }
    ]
  },
  "backup_policy": "none",
  "user_plugin_prefixes": [],
  "user_plugin_suffixes": {
    "windows": [],
    "macos": []
  },
  "category": "additional",
  "github_release": {
    "repo": "surge-synthesizer/surge",
    "release": {
      "tag": "Nightly"
    },
    "version_from": {
      "asset_name": {
        "strip_trailing_dot_segment": false
      }
    },
    "assets": [
      {
        "platform": "windows",
        "name_prefix": "surge-xt-win64-",
        "name_suffix": "-setup.exe",
        "artifact_kind": "installer"
      },
      {
        "platform": "macos",
        "name_prefix": "surge-xt-macOS-",
        "name_suffix": ".dmg",
        "artifact_kind": "disk_image"
      }
    ]
  }
}
